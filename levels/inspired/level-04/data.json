  "acts": [
    {
      "id": "A1",
      "title": "周一早会",
      "variants": [
        {
          "id": "A1-1",
          "nodes": [
            {
              "id": "a11-1",
              "speaker": "boss",
              "line": "这季度做完清单上 8 个功能。第 3 个，销售答应客户了。",
              "timeLimit": 0,
              "options": [
                {
                  "id": "a11-1o",
                  "text": "这 8 个功能想解决什么问题？",
                  "type": "own",
                  "after": "老板：「新用户留不住，次月一半都走了。」"
                },
                {
                  "id": "a11-1l",
                  "text": "好的，我今天就把 8 个全排进去。",
                  "type": "list",
                  "after": "8 个全排进去了，排期一直排到季度末。"
                },
                {
                  "id": "a11-1b",
                  "text": "做不完，我先砍掉一半。",
                  "type": "block",
                  "after": "没说依据，大家不知道该砍哪一半。"
                }
              ]
            },
            {
              "id": "a11-2",
              "speaker": "boss",
              "line": "这季度目标是把新用户留下来。清单你看着分吧。",
              "timeLimit": 0,
              "options": [
                {
                  "id": "a11-2l",
                  "text": "按清单平分给工程师",
                  "type": "list",
                  "after": "大家各做各的，没人知道为什么做。"
                },
                {
                  "id": "a11-2o",
                  "text": "把问题摆给团队，一起看数据",
                  "type": "own",
                  "after": "小李发现：注册要填 6 页资料，很多人第 2 页就走了。"
                },
                {
                  "id": "a11-2s",
                  "text": "先做销售答应客户的那一个",
                  "type": "loud",
                  "after": "客户高兴了，团队的计划往后推。"
                }
              ]
            }
          ]
        },
        {
          "id": "A1-2",
          "nodes": [
            {
              "id": "a12-1",
              "speaker": "boss",
              "line": "续费的老用户现在越来越少了。清单八个功能，季度末前上线。",
              "timeLimit": 0,
              "options": [
                {
                  "id": "a12-1o",
                  "text": "我先去问问不续费的用户",
                  "type": "own",
                  "after": "一问才知道：很多人找不到上次学到哪。"
                },
                {
                  "id": "a12-1l",
                  "text": "行，8 个功能我按顺序排",
                  "type": "list",
                  "after": "工程师接过清单，没人问为什么。"
                },
                {
                  "id": "a12-1s",
                  "text": "先做销售答应客户的那个",
                  "type": "loud",
                  "after": "客户高兴了，别的全往后推。"
                }
              ]
            },
            {
              "id": "a12-2",
              "speaker": "engineer",
              "line": "用户总说找不着上回学到哪了。可清单里没这一条，做不做？",
              "timeLimit": 0,
              "options": [
                {
                  "id": "a12-2l",
                  "text": "不在清单上，先别做吧？",
                  "type": "list",
                  "after": "清单照走，用户还是找不到。"
                },
                {
                  "id": "a12-2o",
                  "text": "先做个小样，找几个人试试",
                  "type": "own",
                  "after": "小李当天就画出了「接着学」按钮。"
                },
                {
                  "id": "a12-2b",
                  "text": "不做，清单外的一律不接",
                  "type": "block",
                  "after": "这事没再提，用户还是找不到上次学到哪。"
                }
              ]
            }
          ]
        }
      ]
    },
    {
